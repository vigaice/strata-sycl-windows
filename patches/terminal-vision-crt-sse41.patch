diff --git a/terminal/tools/vision/CMakeLists.txt b/terminal/tools/vision/CMakeLists.txt
index c44c63d5d..952f1bfb7 100644
--- a/terminal/tools/vision/CMakeLists.txt
+++ b/terminal/tools/vision/CMakeLists.txt
@@ -39,7 +39,14 @@ endif()
 option(STRATA_VISION_METAL "a Mac: our tower's Metal kernels in the program, so --gpu reads pictures on the Mac's GPU (OFF: CPU only)" ON)
 option(STRATA_PORTABLE "build for other PCs: AVX2 baseline, static MSVC runtime" ON)
 if(STRATA_PORTABLE AND MSVC)
-  set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
+  # STRATA_WINDOWS_PATCH: the Intel compiler (icx/icpx) drives clang and rejects /MT together with -fsycl
+  # ("invalid argument 'MT' not allowed with '-fsycl'"), the same conflict the SYCL engine's CMakeLists.txt settles with
+  # the dynamic CRT; cl.exe still gets the static one the comment above describes.
+  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|IntelLLVM")
+    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreadedDLL")
+  else()
+    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
+  endif()
 endif()
 if(STRATA_PORTABLE)
   message(STATUS "strata-vision: portable build (AVX2 baseline, runs on other PCs)")
diff --git a/terminal/tools/vision/own/CMakeLists.txt b/terminal/tools/vision/own/CMakeLists.txt
index 8d9b51ab8..12ede8e6a 100644
--- a/terminal/tools/vision/own/CMakeLists.txt
+++ b/terminal/tools/vision/own/CMakeLists.txt
@@ -113,6 +113,12 @@ else()
   set_source_files_properties(cpu_kernels_avx.cpp PROPERTIES COMPILE_OPTIONS "/arch:AVX")      # (the SSE4.1 tier needs no flag on x64)
   set_source_files_properties(cpu_kernels_avx2.cpp PROPERTIES COMPILE_OPTIONS "/arch:AVX2")
   set_source_files_properties(cpu_kernels_avx512.cpp PROPERTIES COMPILE_OPTIONS "/arch:AVX512")
+  # STRATA_WINDOWS_PATCH: "no flag on x64" holds for cl.exe, which emits an intrinsic whatever the target features are.
+  # clang (icx/icpx) checks them: without -msse4.1 every _mm_cvtepu16_epi32 and _mm_blendv_epi8 in the SSE4.1 tier is
+  # "always_inline function ... requires target feature 'sse4.1'".  SSE4.1 is not part of the x64 baseline.
+  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang|IntelLLVM")
+    set_source_files_properties(cpu_kernels_sse41.cpp PROPERTIES COMPILE_OPTIONS "-msse4.1")
+  endif()
 endif()
 target_include_directories(strata_vit_own PUBLIC ${CMAKE_CURRENT_SOURCE_DIR})
 target_include_directories(strata_vit_own PRIVATE ${STB_DIR})
